Options +FollowSymLinks
RewriteEngine On

# Force HTTPS (optional, uncomment if you want all traffic on HTTPS)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rewrite static pages (without .php in URL)
RewriteRule ^about$ about.php [L]
RewriteRule ^contact$ contact.php [L]
RewriteRule ^pricing$ pricing.php [L]
RewriteRule ^test$ test.php [L]
RewriteRule ^custom-order/healthcare-professional$ custom-order/healthcare-professionals.php [L]
RewriteRule ^ready-made/healthcare-professional$ ready-made/healthcare-professionals.php [L]
RewriteRule ^ready-made/job-level$ ready-made/job-levels.php [L]
RewriteRule ^ready-made/job-title$ ready-made/job-titles.php [L]
RewriteRule ^ready-made/job-function$ ready-made/job-functions.php [L]

# Serve existing files or directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# If no file or directory found, try .php file with same name
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# Laragon PHP configuration
php_flag display_errors On
php_value max_execution_time 180
php_value max_input_time 180
php_value max_input_vars 1000
php_value memory_limit 2048M
php_value post_max_size 1024M
php_value upload_max_filesize 512M
php_flag zlib.output_compression Off
